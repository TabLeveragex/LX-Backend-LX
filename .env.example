PORT=8080

MONGO_CONN=your-mongodb-connection-string

JWT_SECRET=your-jwt-secret-min-32-chars

# hCaptcha
HCAPTCHA_SITE_KEY=your-hcaptcha-site-key
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Email (required) — Gmail: use an App Password, not your login password.
# SMTP_SERVICE must be a nodemailer well-known name such as "gmail".
# Do NOT set this to a product/brand name (e.g. LEVERAGED / leveragex) —
# unknown values make nodemailer connect to 127.0.0.1:587 and all mail fails.
SMTP_SERVICE=gmail
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=your-gmail@gmail.com

# Optional custom SMTP instead of SMTP_SERVICE:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Divine Pay (server-side only — never expose API key in frontend)
DIVINE_PAY_BASE_URL=https://divinepay.us.cc
DIVINE_PAY_API_KEY=your-divine-pay-secret-key

# Must be a real deliverable inbox (admin OTP). Do not use example.com / leveragex.com.
ADMIN_EMAIL=your-gmail@gmail.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=LeverageX Admin

USER_DELETE_MODE=disabled
