HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# Email (required) — Gmail: use App Password, not your login password.
# SMTP_SERVICE must be a nodemailer well-known name (use "gmail"), NOT a product name.
SMTP_SERVICE=gmail
SMTP_USER=leveragexfund@gmail.com
# If Gmail returns 535 BadCredentials, regenerate at https://myaccount.google.com/apppasswords
SMTP_PASS=zbnq wjyp zvlz ifaw
EMAIL_FROM=leveragexfund@gmail.com

# Optional custom SMTP instead of SMTP_SERVICE:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Divine Pay (server-side only — never expose API key in frontend)
DIVINE_PAY_BASE_URL=https://divinepay.us.cc
DIVINE_PAY_API_KEY=your-divine-pay-secret-key
# Optional path overrides if gateway docs differ
# DIVINE_PAY_CREATE_PATH=/api/payin/payin/create
# DIVINE_PAY_STATUS_PATH=/api/payin/status

# Must be a real deliverable inbox (OTP + admin login). Do not use example.com.
